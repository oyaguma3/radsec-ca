# compose の設定。cp .env.example .env して書き換える（.env は chmod 600 にする）。

# 組織の名前（必須。CA の Subject の O と CN に入る。後から変えても、作った CA の名前は変わらない）。
CA_ORG=

# 名前の規則（必須。エッジの EDGE_URN_PREFIX・EDGE_DNS_DOMAIN と同じ値にそろえる）。
CA_URN_PREFIX=example
CA_DNS_DOMAIN=radsec.example.net

# 管理API と配布の口を公開するアドレス（必須。トンネル（WireGuard など）の、このホストのアドレス）。
CA_BIND_ADDR=

# 管理モード（aka-provisioner から使う）では compose.managed.yaml を重ねる（運用ガイド 3 章）。単独モードでは書かない。
# COMPOSE_FILE=compose.yaml:compose.managed.yaml
# ログを管理面の Fluent Bit に送るときは compose.fluent-bit.yaml も足す（COMPOSE_FILE=compose.yaml:compose.managed.yaml:compose.fluent-bit.yaml）。
# 管理API のサーバー証明書の SAN（管理モードの既定は radsec-ca。aka-provisioner からつなぐ名前やアドレス）。
# 管理クライアントのピンは secrets/admin-clients に書く（1 行に 識別名=フィンガープリント。SIGHUP で読み直す）。
CA_TLS_HOSTS=

# Cloudflare Access（必須）。チームのドメイン（<チーム名>.cloudflareaccess.com）と、Access のアプリの AUD タグ。
CA_ACCESS_TEAM_DOMAIN=
CA_ACCESS_AUD=
# 最初の管理者のメールアドレス（必須。起動のたびに admin・有効に戻す）。
CA_INITIAL_ADMIN_EMAIL=

# KEK は secrets/kek、Cloudflare Tunnel のトークンは secrets/tunnel-token に置く（.env には書かない。運用ガイド 2 章）。

# 有効期限（日）と CRL（設計概要 §5.2、§7.2）。
CA_AP_CERT_DAYS=730
CA_GROUP_CERT_DAYS=730
CA_SERVER_CERT_DAYS=365
CA_CRL_VALIDITY=168h
CA_CRL_REFRESH=24h

# 持ち込みの CA の CRL を取りに行く間隔と 1 回の上限（設計概要 §19.3。上限は 25 秒まで）。
CA_BROUGHT_CRL_REFRESH=1h
CA_BROUGHT_CRL_TIMEOUT=20s

# 監査ログの日ごとのファイルの保存の日数。
CA_AUDIT_RETENTION_DAYS=14

# ログのレベル（debug / info / warn / error）。
LOG_LEVEL=info

# コンテナのタイムゾーン（画面の日時の表示に使う）。
TZ=Asia/Tokyo
